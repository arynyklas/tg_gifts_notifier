{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Generated from src/config.py by `uv run python -m scripts.generate_config_schema`.",
  "title": "Config",
  "description": "TG Gifts Notifier configuration.",
  "type": "object",
  "properties": {
    "userbot": {
      "description": "MTProto account that polls the gift catalog and posts the stickers.",
      "type": "object",
      "properties": {
        "api_id": {
          "description": "Telegram API ID from my.telegram.org.",
          "type": "integer"
        },
        "api_hash": {
          "description": "Telegram API hash matching `api_id`.",
          "type": "string"
        },
        "session_path": {
          "description": "Telethon session file.",
          "type": "string",
          "default": "sessions/userbot.session"
        },
        "flood_sleep_threshold": {
          "description": "Flood waits shorter than this many seconds are slept through by Telethon.",
          "type": "integer",
          "default": 60
        }
      },
      "additionalProperties": false,
      "required": [
        "api_id",
        "api_hash"
      ]
    },
    "bot_api": {
      "description": "Bots that send and edit the notification texts.",
      "type": "object",
      "properties": {
        "tokens": {
          "description": "Bot tokens from @BotFather; requests rotate through them. At least one.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "base_url": {
          "description": "Bot API server: `https`, or `http` only for a local server (`localhost`, `127.0.0.1`, `[::1]`).",
          "type": "string",
          "pattern": "^(https://|http://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]+)?(/|$))",
          "default": "https://api.telegram.org"
        },
        "request_timeout": {
          "description": "Bot API request timeout, in seconds.",
          "type": "number",
          "default": 20.0
        }
      },
      "additionalProperties": false,
      "required": [
        "tokens"
      ]
    },
    "detector": {
      "description": "Polling cadence of the gift catalog.",
      "type": "object",
      "properties": {
        "check_interval": {
          "description": "Delay between gift catalog polls, in seconds.",
          "type": "number",
          "default": 1.0
        },
        "updates_batch_delay": {
          "description": "Delay between batches of stock-update edits, in seconds.",
          "type": "number",
          "default": 1.0
        },
        "announce_retry_max_delay": {
          "description": "Upper bound of the backoff for retrying a failed announcement, in seconds.",
          "type": "number",
          "default": 60.0
        }
      },
      "additionalProperties": false
    },
    "storage": {
      "description": "Gift data file.",
      "type": "object",
      "properties": {
        "data_filepath": {
          "description": "Path of the gift data file.",
          "type": "string",
          "default": "star_gifts.json"
        },
        "save_debounce": {
          "description": "Debounce before the data file is rewritten, in seconds.",
          "type": "number",
          "default": 2.0
        }
      },
      "additionalProperties": false
    },
    "notifications": {
      "description": "New gift posts.",
      "type": "object",
      "properties": {
        "chat_id": {
          "description": "Chat where new gift messages are posted.",
          "type": "integer"
        },
        "after_sticker_delay": {
          "description": "Delay after posting a sticker, before its text, in seconds. Paces upgrade posts too.",
          "type": "number",
          "default": 1.0
        },
        "after_text_delay": {
          "description": "Delay after posting a text, in seconds. Paces upgrade posts too.",
          "type": "number",
          "default": 2.0
        },
        "timezone": {
          "description": "IANA timezone of the rendered timestamps and of `--save-only` dump names (e.g. `Europe/Moscow`).",
          "type": "string",
          "default": "UTC"
        }
      },
      "additionalProperties": false,
      "required": [
        "chat_id"
      ]
    },
    "upgrades": {
      "description": "Upgrade posts; disabled unless `chat_id` is set.",
      "type": "object",
      "properties": {
        "chat_id": {
          "description": "Chat where upgrade messages are posted; `null` disables upgrade checks.",
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "check_interval": {
          "description": "Delay between upgradability check cycles, in seconds.",
          "type": "number",
          "default": 2.0
        },
        "check_concurrency": {
          "description": "Concurrent upgradability probes; `--save-only` and a data file migration use it even with upgrades off.",
          "type": "integer",
          "minimum": 1,
          "default": 4
        },
        "text": {
          "description": "Upgrade message (HTML). Placeholders: `{id}`.",
          "type": "string",
          "default": "Gift is upgradable! (<code>{id}</code>)"
        }
      },
      "additionalProperties": false
    },
    "logging": {
      "description": "Log levels and destinations.",
      "type": "object",
      "properties": {
        "telethon_level": {
          "description": "Level of Telethon's own loggers, kept apart from ours; `DEBUG` to debug MTProto.",
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ],
          "default": "WARNING"
        },
        "console": {
          "description": "Console log output.",
          "type": "object",
          "properties": {
            "level": {
              "description": "Console log level.",
              "enum": [
                "DEBUG",
                "INFO",
                "WARNING",
                "ERROR",
                "CRITICAL"
              ],
              "default": "INFO"
            }
          },
          "additionalProperties": false
        },
        "file": {
          "description": "Rotating log file.",
          "type": "object",
          "properties": {
            "level": {
              "description": "File log level.",
              "enum": [
                "DEBUG",
                "INFO",
                "WARNING",
                "ERROR",
                "CRITICAL"
              ],
              "default": "INFO"
            },
            "path": {
              "description": "Log file path.",
              "type": "string",
              "default": "logs/main.log"
            },
            "max_bytes": {
              "description": "Size at which the log file is rotated, in bytes.",
              "type": "integer",
              "default": 10485760
            },
            "backup_count": {
              "description": "Number of rotated log files kept.",
              "type": "integer",
              "default": 5
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "texts": {
      "description": "New gift message templates (HTML).",
      "type": "object",
      "properties": {
        "new_gift": {
          "description": "New gift message. Placeholders: `{title}`, `{number}`, `{id}`, `{total_amount}`, `{available_amount}`, `{sold_out}`, `{price}`, `{convert_price}`, `{require_premium_or_user_limited}`.",
          "type": "string"
        },
        "title": {
          "description": "Title line, inserted as `{title}`.",
          "type": "object",
          "properties": {
            "limited": {
              "description": "Inserted as `{title}` for a limited gift.",
              "type": "string"
            },
            "regular": {
              "description": "Inserted as `{title}` for an unlimited gift.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "limited",
            "regular"
          ]
        },
        "total_amount": {
          "description": "Inserted as `{total_amount}` for a limited gift. Placeholders: `{total_amount}`.",
          "type": "string"
        },
        "available_amount": {
          "description": "Inserted as `{available_amount}` for a limited gift. Placeholders: `{available_amount}`, `{same_str}`, `{available_percentage}`, `{updated_datetime}`.",
          "type": "string"
        },
        "sold_out": {
          "description": "Inserted as `{sold_out}` once a gift is sold out. Placeholders: `{sold_out}`.",
          "type": "string"
        },
        "requirements": {
          "description": "Premium and per-user limit line, inserted as `{require_premium_or_user_limited}`.",
          "type": "object",
          "properties": {
            "template": {
              "description": "Layout of the line. Placeholders: `{emoji}`, `{require_premium}`, `{separator}`, `{user_limited}`.",
              "type": "string"
            },
            "emoji": {
              "description": "Inserted as `{emoji}`.",
              "type": "string"
            },
            "premium": {
              "description": "Inserted as `{require_premium}` when the gift needs Telegram Premium.",
              "type": "string"
            },
            "user_limited": {
              "description": "Inserted as `{user_limited}` when the gift is limited per user. Placeholders: `{user_limited}`.",
              "type": "string"
            },
            "separator": {
              "description": "Inserted as `{separator}` when both parts are present.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "template",
            "emoji",
            "premium",
            "user_limited",
            "separator"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "new_gift",
        "title",
        "total_amount",
        "available_amount",
        "sold_out",
        "requirements"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "userbot",
    "bot_api",
    "notifications",
    "texts"
  ]
}
